#!/usr/bin/env bash
# Serve the static app. Prefer python3 http.server (no extra deps).
set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${PORT:-8080}"
echo "==> start static server on port $PORT"
echo "    Open http://127.0.0.1:${PORT}/"
echo "    Success: page shows 'Introduction — draft' from Persistence seed"

if command -v python3 >/dev/null 2>&1; then
  exec python3 -m http.server "$PORT" --bind 127.0.0.1
fi

if command -v npx >/dev/null 2>&1; then
  exec npx --yes serve -l "tcp://127.0.0.1:${PORT}" .
fi

echo "ERROR: need python3 or npx to serve static files" >&2
exit 1
