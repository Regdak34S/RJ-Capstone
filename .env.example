# Content Creation Project — environment variables
# Copy to .env for local overrides. Never commit .env.
# This app is static + browser localStorage; most vars are for CI/smoke only.

# Port used by script/start (static file server)
PORT=8080

# Base URL for script/smoke (must match PORT)
APP_BASE_URL=http://127.0.0.1:8080

# Substring the smoke test expects in the rendered HTML / API response
SMOKE_EXPECT=Introduction

# Storage key used by Persistence (must match src/persistence/project-store.js)
STORAGE_KEY=ccp:project:v1

# Set to "1" to force Persistence to treat storage as unavailable (for red tests)
FORCE_STORAGE_DOWN=
