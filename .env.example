# Content Creation Project — configuration contract
# Copy: cp .env.example .env
# Never commit .env (see .gitignore).
# Runtime product: static HTML/JS + browser localStorage — no API keys required.

# --- Local static server (script/start) ---
# Port for the local static file server.
# Required for local run: no (defaults to 8080 if unset)
# Safe local value: 8080
PORT=8080

# --- Smoke test (script/smoke) ---
# Base URL smoke will probe after start (must match PORT).
# Required for smoke HTTP check: no (store check still runs without server)
# Safe local value:
APP_BASE_URL=http://127.0.0.1:8080

# Substring that must appear when smoke reads the store/seed path.
# Required for smoke: yes (script expects a non-empty expect string)
# Safe local value:
SMOKE_EXPECT=Introduction

# --- Persistence (must match src if overridden) ---
# localStorage / MemoryAdapter key for the project document.
# Required: no (code has default ccp:project:v1)
# Safe local value:
STORAGE_KEY=ccp:project:v1

# Force storage adapter failure for red-path tests (CI / smoke).
# Required: no — leave empty for normal runs
# Safe local value: empty
# Set to 1 only for intentional failure demos
FORCE_STORAGE_DOWN=

# There are no production API keys, database URLs, or OAuth secrets for v1.0.0.
# If you add one later: put the name here, mark required, leave value empty in example,
# store real value only in GitHub Actions secrets or local .env, and update docs/handoff.md §3.

